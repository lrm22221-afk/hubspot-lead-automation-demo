PORT=3000
# Shared secret the form tool sends as X-Webhook-Token header or ?token= query parameter
WEBHOOK_TOKEN=change-me
# Bearer token for /admin/dlq and /admin/dlq/replay
ADMIN_TOKEN=change-me-too

# HubSpot private app token (needs read/write scopes for contacts and deals; check the scopes HubSpot lists for the tasks endpoints)
HUBSPOT_PRIVATE_APP_TOKEN=pat-xx-xxxxxxxx
HUBSPOT_BASE_URL=https://api.hubapi.com
# Optional custom contact property for the score (create it in HubSpot first, type number); leave empty to skip
HUBSPOT_SCORE_PROPERTY=
# Calling code for local phone numbers when the lead's country is unknown
DEFAULT_CALLING_CODE=972

# Alerts (optional)
SLACK_WEBHOOK_URL=
# Generic JSON email relay: receives {to, subject, text}
EMAIL_WEBHOOK_URL=
ALERT_EMAIL_TO=

RETRY_MAX_ATTEMPTS=5
RETRY_BASE_MS=500
DLQ_FILE=data/dead-letter.jsonl
# Optional path to a custom rules file (default rules/rules.json)
RULES_FILE=
